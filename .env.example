# ==========================================
# WILDTRAIL ENVIRONMENT CONFIGURATION
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/wildtrail

# Authentication (JWT)
# IMPORTANT: Generate strong 64+ char random strings in production
JWT_ACCESS_SECRET=wildtrail_super_secret_access_jwt_key_2026_secure
JWT_REFRESH_SECRET=wildtrail_super_secret_refresh_jwt_key_2026_secure
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Stripe Payment Gateway (TEST MODE)
# IMPORTANT SECURITY NOTE: Never commit your real Stripe Secret Key.
# If any key was previously committed to git history, ROTATE IT IMMEDIATELY in the Stripe Dashboard.
STRIPE_SECRET_KEY=sk_test_placeholder_key_replace_with_your_stripe_test_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_test_key

# Storage & Uploads
MEDIA_STORAGE_TYPE=local
MEDIA_BASE_URL=http://localhost:5000/uploads
MAX_FILE_SIZE_MB=5
